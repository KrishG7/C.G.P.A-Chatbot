# Copy to .env (git-ignored) and fill in. Never commit real keys.
GEMINI_API_KEY=
# Optional: defaults to the gemini-flash-latest alias. Google retires named models.
GEMINI_MODEL=gemini-flash-latest
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Server-side only. Prefer the service_role key with Row Level Security enabled.
SUPABASE_KEY=
